{
  "_comment": "SRDM Asimov sensitivity: profile PL on pattern CSVs. sigma_grid_mode: intersection (default), union (common σ + interpolation), or per_mass (each mass uses its own CSV xsec grid; see configs/scan_srdm_pattern_csv_per_mass_pydme_minuit.json).",
  "run": {
    "label": "scan_srdm_pattern_csv_intersection_pydme_minuit",
    "outdir": "outputs/scan_srdm_pattern_csv_intersection_pydme_minuit",
    "sigma_grid_mode": "intersection",
    "n_toys": 0,
    "rng_seed": 12345,
    "verbosity": 1,
    "cl": 0.9,
    "test_stat": "PLR",
    "use_profile_likelihood": true,
    "data_path": "",
