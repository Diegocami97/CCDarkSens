{
  "material": "Si",
  "darkelf_dir": "/Users/diegovenegasvargas/Documents/Software/DarkELF",

  "detector": {
    "band_gap_eV": null,
    "binsize_eV": 0.1
  },

  "rates_dir": "data/darkphoton_rates/Si",
  "filename_template": "dRdE_{material}_absorption_m{mA_eV}_e{epsilon}.csv",

  "grid": {
    "mA_eV": { "logspace": {"start_exp": 0.0, "stop_exp": 2.0, "num": 200} },
    "epsilon": { "logspace": {"start_exp": -20, "stop_exp": -10, "num": 40} }
  },

  "options": {
    "skip_existing": true,
    "overwrite": false,
    "parallel": 1,
    "progress": true,
    "format": { "mA": ".6f", "epsilon": ".3e" }
  }
}