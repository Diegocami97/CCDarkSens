{
  "_comment": "Migdal rate generation: SrCd2Sb2 compound (1Sr+2Cd+2Sb), light mediator, 80x30 grid. Lindhard method, Enth=0. Run: python3 utils/migdal_generate_grid.py configs/migdal_generate_srcd2sb2_light_80x30.json",
  "material": "srcd2sb2",
  "mediator": "light",
  "darkelf_dir": "/Users/diegovenegasvargas/Documents/Software/DarkELF",

  "detector": {
    "Emin_eV": 0.0,
    "Emax_eV": 20.0,
    "binsize_eV": 0.1
  },

  "rates_dir": "data/migdal_rates/SrCd2Sb2/light_80x30",
  "filename_template": "dRdE_{target_nucleus}_{mediator}_m{mchi_MeV}_s{sigma_n_cm2}.csv",

  "grid": {
    "mchi_MeV": {
      "logspace": { "start": 0.1, "stop": 1000.0, "num": 80, "endpoint": true }
    },
    "sigma_n_cm2": {
      "logspace": { "start_exp": -45, "stop_exp": -25, "num": 30, "endpoint": true }
    }
  },

  "options": {
    "skip_existing": true,
    "overwrite": false,
    "parallel": 0,
    "format": { "mchi": ".6f", "sigma": ".1e" }
  }
}
