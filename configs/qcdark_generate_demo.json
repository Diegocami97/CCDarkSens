  "options": {
    "skip_existing": false,
    "overwrite": false,
    "compress": false,
    "parallel": 1,
    "progress": true,
    "use_sigma_scaling": true,
    "sigma_ref": 1e-37,
    "format": { "mchi": ".6f", "sigma": ".1e" }
  }
