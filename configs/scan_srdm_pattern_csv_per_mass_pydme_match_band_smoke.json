    "n_toys": 0,
    "rng_seed": 12345,
    "verbosity": 1,
    "cl": 0.9,
    "test_stat": "PLR",
    "use_profile_likelihood": true,
    "background_source": "bp_br_template",
    "background_model": "Bp_theta_Br",
    "background_Bp": [141.4, 0.111, 0.042, 0.019, 2.5e-5, 5.8e-5],
    "background_Br": [0.039, 0.039, 0.016, 0.052, 0.011, 0.035],
    "observed_counts": [144, 0, 0, 1, 0, 0],
    "constrain_prior_strength": 98,
    "constrain_use_gamma_sign": false,
    "constrain_use_tau_weighted": false,
    "constrain_n_bins": 4450,
    "theta_lo": 0.5,
    "theta_hi": 10,
    "profile_minimizer": "pydme",
    "dump_spat_point_mchi_MeV": 1.0,
    "dump_spat_point_sigma_e_cm2": 1.905461E-38,
    "observable_bins": "pattern"
  },
  "detector": {
    "mass_kg": 0.5
  },
  "experiment": {
    "livetime_days": 2.6,
    "duty_cycle": 1.0,
    "roi_bins": [2, 3, 4, 5],
    "pattern_roi": [11, 21, 111, 31, 22, 211]
  },
  "srdm_signal_csv": {
    "input_dir": "outputs/qcdark_srdm_gamma_0p4645605",
    "filename_regex": "pattern_signal_summed_mX([0-9]+(?:\\.[0-9]+)?)_full_QCD",
    "rates_are_per_gram_per_day": true,
    "signal_rate_scale": 1.0
  },
  "band": {
    "scan_binary": "build/ccdarksens_scan_srdm_pattern_csv",
    "n_toys": 20,
    "outdir": "outputs/band_srdm_pattern_csv_per_mass_pydme_match_smoke",
    "rng_seed": 7777,
    "n_workers": 0,
    "threshold": "asymptotic",
    "background_bp_key": "run.background_Bp",
    "background_br_key": "run.background_Br",
    "ul_graph_name": "upper_limit_sigma_e_mchi_graph",
    "save_per_toy_curves": false,
    "keep_per_toy_outputs": false,
    "abort_on_failure": false,
    "min_success_fraction": 0.50
  }
