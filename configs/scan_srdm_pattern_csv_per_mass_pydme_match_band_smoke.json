{
  "_comment": "Smoke-test config for ccdarksens_band: same physics inputs as scan_srdm_pattern_csv_per_mass_pydme_match.json but only 20 outer toys, asymptotic threshold (skips Phase 0/1) for fast verification.",
  "run": {
    "label": "scan_srdm_pattern_csv_per_mass_pydme_match",
    "outdir": "outputs/scan_srdm_pattern_csv_per_mass_pydme_match",
