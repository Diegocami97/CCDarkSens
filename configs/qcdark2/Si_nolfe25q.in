# Si dielectric without LFE, high q (matches shipped Si_comp tail: 8k, q up to ~25 ame).
# Use after Si_lfe8q; merge LFE + nolfe segments for full Si_comp-like tables (see docs).

save_path = /Users/diegovenegasvargas/Documents/CCDarkSens/data/qcdark2_epsilon/Si
name = Si_nolfe25q_gap{SCISSOR_TAG}

include_lfe = False
q_max = 25
q_min = 0
dq = 0.02
dE = 0.1
E_max = 50.0

mpi = False

unit = angstrom
lattice_vectors = [[2.715, 2.715, 0.0], [0.0, 2.715, 2.715], [2.715, 0.0, 2.715]]
atom = Si, 0., 0., 0.; Si, 1.3575, 1.3575, 1.3575
basis = Si: cc-pv(t+d)z

xcfunc = pbe
k_grid = [8,8,8]
q_shift = [0.01, 0.01, 0.01]

scissor_bandgap = {SCISSOR}
