# Fast Si dielectric for scissor band-gap scans (0.1–1.2 eV).
# Reuses DFT under save_path/DFT_resources when lattice/basis/k_grid/xc match a prior run.
# NOT Si_comp production quality — use Si_lfe8q.in + Si_nolfe25q.in for that later.

save_path = /Users/diegovenegasvargas/Documents/CCDarkSens/data/qcdark2_epsilon/Si
name = Si_fast_gap{SCISSOR_TAG}

include_lfe = False
q_max = 2.0
q_min = 0
dq = 0.02
dE = 0.1
E_max = 50.0

mpi = False

unit = angstrom
lattice_vectors = [[2.715, 2.715, 0.0], [0.0, 2.715, 2.715], [2.715, 0.0, 2.715]]
atom = Si, 0., 0., 0.; Si, 1.3575, 1.3575, 1.3575
basis = Si: cc-pv(t+d)z

xcfunc = pbe
k_grid = [4,4,4]

scissor_bandgap = {SCISSOR}
