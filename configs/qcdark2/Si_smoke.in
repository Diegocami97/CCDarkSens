# Quick validation run for CCDarkSens + QCDark2 pipeline (~minutes, not production).
# DFT is cached under save_path/DFT_resources for later production runs.

save_path = /Users/diegovenegasvargas/Documents/CCDarkSens/data/qcdark2_epsilon/Si
name = Si_smoke_nolfe_q1

include_lfe = False
q_max = 1.0
q_min = 0
dq = 0.02
dE = 0.1
E_max = 10.0

mpi = False

unit = angstrom
lattice_vectors = [[2.715, 2.715, 0.0], [0.0, 2.715, 2.715], [2.715, 0.0, 2.715]]
atom = Si, 0., 0., 0.; Si, 1.3575, 1.3575, 1.3575
basis = Si: cc-pv(t+d)z

xcfunc = pbe
k_grid = [4,4,4]

scissor_bandgap = 1.2
