# Si dielectric with LFE, low–mid q (matches shipped Si_comp LFE segment: 8k, ~8 ame).
# Re-run with different scissor_bandgap to vary band gap; DFT under save_path is reused.

save_path = /Users/diegovenegasvargas/Documents/CCDarkSens/data/qcdark2_epsilon/Si
name = Si_lfe8q_gap{SCISSOR_TAG}

include_lfe = True
q_max = 8
q_min = 0
dq = 0.02
dE = 0.1
E_max = 50.0
N_theta = 9
N_phi = 16

mpi = False

unit = angstrom
lattice_vectors = [[2.715, 2.715, 0.0], [0.0, 2.715, 2.715], [2.715, 0.0, 2.715]]
atom = Si, 0., 0., 0.; Si, 1.3575, 1.3575, 1.3575
basis = Si: cc-pv(t+d)z

xcfunc = pbe
k_grid = [8,8,8]
q_shift = [0.066286, 0.066286, 0.066286]

scissor_bandgap = {SCISSOR}
