{
  "_comment": "Two-point grid run that dumps per-point spectra to ROOT: dRdE(E), S_true(n_e), and S_pat(pattern). Set experiment.observable_bins='ne' to dump S_obs(n_e) instead.",
  "run": {
    "label": "two_point_spectra_dump_pattern",
    "outdir": "outputs/two_point_spectra_dump_pattern",
    "cl": 0.9,
    "test_stat": "PLR",
    "n_toys": 0,
    "rng_seed": 12345,
    "verbosity": 1,
    "dump_point_spectra_root": true,
    "use_profile_likelihood": false,
    "data_path": "",
    "background_source": "dc_flat",
    "background_model": "scale",
    "profile_minimizer": "brent",
    "pydme_style_ul": false
  },
  "detector": {
    "rows": 1300,
    "cols": 6300,
    "pixel_size_um": 15.0,
    "thickness_mm": 0.67,
    "active_fraction": 0.98,
    "target_element": "Si",
    "density_g_cm3": 2.329,
    "mass_kg": 0.027
  },
  "experiment": {
    "mode": "asimov",
    "livetime_days": 10.0,
    "duty_cycle": 1.0,
    "binning": { "ne_min": 1, "ne_max": 10 },
    "roi_bins": [ 2, 3, 4, 5 ],
    "pattern_roi": [ 11, 21, 111, 31, 22, 211 ],
    "observable_bins": "pattern"
  },
  "response": {
    "mode": "pattern",
    "analysis_space": "pattern",
    "efficiency_mc": {
      "efficiency_csv": "data/Efficiencies_patterns_Nsims1000000_DCTrue_alpha1.csv",
      "efficiency_csv_reference": "data/Efficiencies_patterns_Nsims1000000_DCTrue_alpha1.csv",
      "n_events_per_ne": 1000000,
      "sigma_readout_e": 0.16,
      "Qmin_e": 0.6,
      "Qmax_e": 20.0,
      "A_um2": 803.25,
      "b_umInv": 0.00065,
      "alpha": 1.0,
      "beta_per_keV": 0.0,
      "half_window_pix": 2,
      "row_length": 32,
      "rows_bin": 1,
      "cols_bin": 1,
      "pileup_with_dc": false,
      "enable_MN": true,
      "enable_MNL": true,
      "use_2d_image_efficiency": false,
      "rng_seed": 987654321
    },
    "pcd": { "q_min": 0.0, "q_max": 20.0, "nbins": 200, "mc_trials": 50000 }
  },
  "backgrounds": {
    "dark_current": { "lambda_e_per_pix_per_year": 5.43, "norm_scale": 1.0 },
    "pattern_efficiency": { "type": "flat", "epsilon": 0.95 },
    "timing": { "exposure_time_s": 1800, "n_exposures": null },
    "flat_background": { "norm_per_kg_year_keV": 15, "Emin_eV": 2, "Emax_eV": 10, "nbins": 100 },
    "background_efficiency_csv": ""
  },
  "model": {
    "type": "dm_electron",
    "material": "Si",
    "mediator": "heavy",
    "rates_dir": "data/qedark_rates/Si/heavy/after_third_fix",
    "filename_template": "dRdE_{material}_{mediator}_m{mchi_MeV}_s{sigma_e_cm2}.csv",
    "Emin_eV": 1.2,
    "Emax_eV": 20,
    "nbins": 200,
    "grid": {
      "mchi_MeV": { "values": [10.0, 100.0] },
      "sigma_e_cm2": { "values": [5e-37] },
      "format": { "mchi": ".6f", "sigma": ".1e" }
    }
  }
}

