{
  "_comment": "Migdal rate generation config: Si target, light mediator (F_DM propto 1/q^2). Generates dR/dE_e CSVs via darkelf.dRdomega_migdal(). Run: python3 utils/migdal_generate_grid.py configs/migdal_generate_si_light.json",
  "material": "Si",
  "mediator": "light",
  "darkelf_dir": "/Users/diegovenegasvargas/Documents/Software/DarkELF",

  "detector": {
    "Emin_eV": 0.0,
    "Emax_eV": 20.0,
    "binsize_eV": 0.1
  },

  "rates_dir": "data/migdal_rates/Si/light",
  "filename_template": "dRdE_{target_nucleus}_{mediator}_m{mchi_MeV}_s{sigma_n_cm2}.csv",

  "grid": {
    "mchi_MeV": {
      "logspace": {
        "start": 10.0,
        "stop": 1000.0,
        "num": 200,
        "endpoint": true
      }
    },
    "sigma_n_cm2": {
      "logspace": {
        "start_exp": -42,
        "stop_exp": -30,
        "num": 200,
        "endpoint": true
      }
    }
  },

  "options": {
    "skip_existing": true,
    "overwrite": false,
    "parallel": 0,
    "format": { "mchi": ".6f", "sigma": ".1e" }
  }
}
